# Platform Environment Configuration

# Environment Setup
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_dev
POSTGRES_DB=enterprise_governance_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# MinIO / Object Storage Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_password
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_BUCKET_BRONZE=bronze-lake
MINIO_BUCKET_SILVER=silver-lake
MINIO_BUCKET_GOLD=gold-lake

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# Data Generator Configuration
DATA_GENERATOR_SCALE=small # Options: small (1K), medium (50K), large (500K)

# Prometheus / Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
